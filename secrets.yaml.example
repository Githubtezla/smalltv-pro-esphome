# Copy to secrets.yaml and fill in. secrets.yaml is ignored by git.
# Keep secrets.yaml safe: without the OTA password you can only flash the clock over UART.
wifi_ssid: "YourWifi"
wifi_password: "your-wifi-password"
# 32 random bytes, base64; e.g.  openssl rand -base64 32
api_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"
ota_password: "choose-a-long-random-password"
